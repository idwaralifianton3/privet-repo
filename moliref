String aktivitas() {
  final jam = DateTime.now().hour;
  final List<String> daftar;
  if (jam >= 5 && jam < 11) {
    daftar = aktivitasPagi;
  } else if (jam >= 11 && jam < 17) {
    daftar = aktivitasSiang;
  } else {
    daftar = aktivitasMalam;
  }
  return acak(daftar);
}

